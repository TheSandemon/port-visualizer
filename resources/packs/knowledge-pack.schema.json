{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portvisualizer.local/schemas/knowledge-pack-v1.json",
  "title": "Port Visualizer knowledge pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "enabledByDefault", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$" },
    "name": { "type": "string", "maxLength": 120 },
    "version": { "type": "integer", "minimum": 1 },
    "enabledByDefault": { "type": "boolean" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "when", "annotate"],
        "properties": {
          "id": { "type": "string", "maxLength": 80 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "when": {
            "type": "object",
            "required": ["all"],
            "properties": { "all": { "type": "array", "minItems": 1 } }
          },
          "annotate": { "type": "object", "minProperties": 1 }
        }
      }
    }
  }
}
